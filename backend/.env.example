# Application
APP_NAME=AgriMind AI
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://agrimind:agrimind123@localhost:5432/agrimind_db
DATABASE_URL_SYNC=postgresql://agrimind:agrimind123@localhost:5432/agrimind_db

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# External APIs
# ── Active Public APIs (100% Free & Keyless from github.com/public-apis/public-apis)
WEATHER_PROVIDER=open-meteo
MAPS_PROVIDER=openstreetmap
OPENMETEO_API_URL=https://api.open-meteo.com/v1/forecast
PHOTON_GEOCODING_URL=https://photon.komoot.io/api

# ── Optional Commercial APIs (Not required! Only if you choose to use paid services)
# OpenWeatherMap: https://home.openweathermap.org/users/sign_up
OPENWEATHERMAP_API_KEY=
# Google Maps: https://console.cloud.google.com/
GOOGLE_MAPS_API_KEY=
# India Agmarknet / e-NAM: https://data.gov.in
DATA_GOV_IN_API_KEY=
ENAM_API_URL=https://enam.gov.in/api

# Storage
STORAGE_TYPE=local
STORAGE_PATH=./uploads
S3_BUCKET=agrimind-storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Notifications
FCM_SERVER_KEY=your_fcm_server_key
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1234567890
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# ML Models
ML_MODELS_PATH=../ml/models
DISEASE_MODEL_PATH=../ml/models/disease_yolov8.pt
CROP_HEALTH_MODEL_PATH=../ml/models/crop_health_cnn.h5

# MQTT (IoT)
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
